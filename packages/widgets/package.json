{
  "name": "@phfsantos/markdown-widgets",
  "version": "1.0.0",
  "description": "Interactive dashboard widgets for VSCode markdown editor",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./widgets/*": {
      "import": "./dist/widgets/*.mjs",
      "require": "./dist/widgets/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --require ./vite.crypto-shim.cjs ./node_modules/vite/bin/vite.js",
    "build": "node --require ./vite.crypto-shim.cjs ./node_modules/vite/bin/vite.js build",
    "type-check": "tsc --noEmit --skipLibCheck",
    "preview": "node --require ./vite.crypto-shim.cjs ./node_modules/vite/bin/vite.js preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "markdown",
    "widgets",
    "dashboard",
    "visualization",
    "vscode",
    "web-components"
  ],
  "author": "@phfsantos",
  "license": "MIT",
  "dependencies": {
    "@lit/react": "^1.0.0",
    "dompurify": "^3.0.0",
    "lit": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "simple-notification-sounds": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
