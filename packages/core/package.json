{
  "name": "@markdown-editor/core",
  "version": "0.0.0",
  "private": true,
  "description": "Environment-neutral Markdown editor rules",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "type-check": "tsc --noEmit -p .",
    "build": "tsc -p .",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "5.3.3",
    "vitest": "^4.1.10"
  }
}
