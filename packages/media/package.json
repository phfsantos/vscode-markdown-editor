{
  "name": "@markdown-editor/media",
  "version": "0.0.0",
  "private": "true",
  "scripts": {
    "start": "yarn esbuild ./src/main.ts --bundle --watch --sourcemap --outfile=../../out/media/main.js",
    "build": "rm -rf ../../out/media; yarn esbuild ./src/main.ts --bundle --minify --sourcemap --outfile=../../out/media/main.js && mkdir -p ../../out/media/dist/js && mkdir -p ../../out/media/dist/css && cp -r ./node_modules/vditor/dist/js ../../out/media/dist/ && cp -r ./node_modules/vditor/dist/css ../../out/media/dist/"
  },
  "browserslist": "> 0%",
  "devDependencies": {
    "@types/node": "^14.14.41",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.13.17",
    "@phfsantos/kanban-board": "1.3.3",
    "@testing-library/dom": "^7.30.4",
    "@testing-library/user-event": "^13.1.5",
    "date-fns": "^2.21.1",
    "esbuild": "0.27.4",
    "jquery": "^3.6.0",
    "jquery-confirm": "^3.3.4",
    "lit": "^3.0.0",
    "lodash": "^4.17.21",
    "predictionary": "^1.6.0",
    "simple-notification-sounds": "^1.0.0",
    "vditor": "^3.8.4"
  }
}
