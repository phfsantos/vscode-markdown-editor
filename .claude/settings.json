{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PROJECT_DIR\" ] && { [ -n \"$CLAUDECODE\" ] || [ -z \"$COPILOT_PROJECT_DIR\" ]; }; then bash \"$CLAUDE_PROJECT_DIR/.projectmind/hooks/session-start.sh\" claude; fi",
            "windows": "if ($env:CLAUDE_PROJECT_DIR -and ($env:CLAUDECODE -or -not $env:COPILOT_PROJECT_DIR)) { & (Join-Path $env:CLAUDE_PROJECT_DIR '.projectmind/hooks/session-start.ps1') claude }"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PROJECT_DIR\" ] && { [ -n \"$CLAUDECODE\" ] || [ -z \"$COPILOT_PROJECT_DIR\" ]; }; then bash \"$CLAUDE_PROJECT_DIR/.projectmind/hooks/prompt-submitted.sh\" claude; fi",
            "windows": "if ($env:CLAUDE_PROJECT_DIR -and ($env:CLAUDECODE -or -not $env:COPILOT_PROJECT_DIR)) { & (Join-Path $env:CLAUDE_PROJECT_DIR '.projectmind/hooks/prompt-submitted.ps1') claude }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PROJECT_DIR\" ] && { [ -n \"$CLAUDECODE\" ] || [ -z \"$COPILOT_PROJECT_DIR\" ]; }; then bash \"$CLAUDE_PROJECT_DIR/.projectmind/hooks/pre-tool-use.sh\" claude; fi",
            "windows": "if ($env:CLAUDE_PROJECT_DIR -and ($env:CLAUDECODE -or -not $env:COPILOT_PROJECT_DIR)) { & (Join-Path $env:CLAUDE_PROJECT_DIR '.projectmind/hooks/pre-tool-use.ps1') claude }"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PROJECT_DIR\" ] && { [ -n \"$CLAUDECODE\" ] || [ -z \"$COPILOT_PROJECT_DIR\" ]; }; then bash \"$CLAUDE_PROJECT_DIR/.projectmind/hooks/post-tool-use.sh\" claude; fi",
            "windows": "if ($env:CLAUDE_PROJECT_DIR -and ($env:CLAUDECODE -or -not $env:COPILOT_PROJECT_DIR)) { & (Join-Path $env:CLAUDE_PROJECT_DIR '.projectmind/hooks/post-tool-use.ps1') claude }"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PROJECT_DIR\" ] && { [ -n \"$CLAUDECODE\" ] || [ -z \"$COPILOT_PROJECT_DIR\" ]; }; then bash \"$CLAUDE_PROJECT_DIR/.projectmind/hooks/session-end.sh\" claude; fi",
            "windows": "if ($env:CLAUDE_PROJECT_DIR -and ($env:CLAUDECODE -or -not $env:COPILOT_PROJECT_DIR)) { & (Join-Path $env:CLAUDE_PROJECT_DIR '.projectmind/hooks/session-end.ps1') claude }"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PROJECT_DIR\" ] && { [ -n \"$CLAUDECODE\" ] || [ -z \"$COPILOT_PROJECT_DIR\" ]; }; then bash \"$CLAUDE_PROJECT_DIR/.projectmind/hooks/delivery-gate.sh\" claude; fi",
            "windows": "if ($env:CLAUDE_PROJECT_DIR -and ($env:CLAUDECODE -or -not $env:COPILOT_PROJECT_DIR)) { & (Join-Path $env:CLAUDE_PROJECT_DIR '.projectmind/hooks/delivery-gate.ps1') claude }"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PROJECT_DIR\" ] && { [ -n \"$CLAUDECODE\" ] || [ -z \"$COPILOT_PROJECT_DIR\" ]; }; then bash \"$CLAUDE_PROJECT_DIR/.projectmind/hooks/pre-compact.sh\" claude; fi",
            "windows": "if ($env:CLAUDE_PROJECT_DIR -and ($env:CLAUDECODE -or -not $env:COPILOT_PROJECT_DIR)) { & (Join-Path $env:CLAUDE_PROJECT_DIR '.projectmind/hooks/pre-compact.ps1') claude }"
          }
        ]
      }
    ]
  }
}
