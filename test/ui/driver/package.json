{
  "name": "context-ui-driver",
  "publisher": "markdown-studio-tests",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "context-ui.open",
        "title": "Context UI: Open Test Document"
      },
      {
        "command": "context-ui.snapshot",
        "title": "Context UI: Record Snapshot"
      },
      {
        "command": "context-ui.other",
        "title": "Context UI: Open Other Document"
      },
      {
        "command": "context-ui.clear",
        "title": "Context UI: Open Unrelated Document"
      },
      {
        "command": "context-ui.badgesOff",
        "title": "Context UI: Disable Badges"
      },
      {
        "command": "context-ui.badgesOn",
        "title": "Context UI: Enable Badges"
      },
      {
        "command": "context-ui.chat",
        "title": "Context UI: Focus Chat"
      },
      {
        "command": "context-ui.diffReport",
        "title": "Diff UI: Record Report"
      },
      {
        "command": "context-ui.diffCloseAll",
        "title": "Diff UI: Close All"
      },
      {
        "command": "context-ui.diffFileCompare",
        "title": "Diff UI: Open File Compare"
      },
      {
        "command": "context-ui.diffGit",
        "title": "Diff UI: Open Git Working Tree Diff"
      },
      {
        "command": "context-ui.diffPending",
        "title": "Diff UI: Open Pending Edit"
      },
      {
        "command": "context-ui.diffResetFixtures",
        "title": "Diff UI: Reset Fixtures"
      },
      {
        "command": "context-ui.diffSaveAll",
        "title": "Diff UI: Save All"
      },
      {
        "command": "context-ui.diffDocuments",
        "title": "Diff UI: Record Documents"
      },
      {
        "command": "context-ui.diffOpenDefault",
        "title": "Diff UI: Open Default Editor"
      }
    ]
  }
}
